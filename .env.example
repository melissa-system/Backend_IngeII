# Copia este archivo como .env y completa los valores.
# El .env real NUNCA se sube al repositorio.

# --- General ---
NODE_ENV=development
PORT=3000

# --- Base de datos MySQL (remota, compartida por el equipo) ---
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# --- JWT (autenticación) ---
# Genera cada secret con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- URL del frontend (para los enlaces que van en los correos) ---
FRONTEND_URL=http://localhost:5173

# --- Correo (recuperación de contraseña y activación de cuenta) ---
# Con Gmail: EMAIL_PASS es una "contraseña de aplicación" (requiere
# verificación en 2 pasos activada), no la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ASADA Pueblo Nuevo <no-reply@asada.local>"
PASSWORD_RESET_EXPIRES_MINUTES=30
ACCOUNT_ACTIVATION_EXPIRES_HOURS=24

# --- Cloudinary (almacenamiento externo de documentos e imágenes) ---
# Los tres valores salen del Dashboard de Cloudinary al iniciar sesión.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=